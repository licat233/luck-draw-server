syntax = "v1"

type usersPool {
	Id         int64     `json:"id"`          // 表主键
	Uuid       string    `json:"uuid"`        // 唯一识别码
	ActivityId int64     `json:"activity_id"` // 活动id
	UserId     int64     `json:"user_id"`     // 奖品id
	Status     int64     `json:"status"`      // 状态：-1已被禁止,0未授权，1已授权
	Score      int64     `json:"score"`       // 用户在当前活动的积分
	CreateAt   int64     `json:"create_at"`   // 创建时间
	UpdateAt   int64     `json:"update_at"`   // 更新时间
	IsDeleted  int64     `json:"is_deleted"`  // 是否已被删除
	DeleteAt   int64     `json:"delete_at"`   // 删除时间
}

type usersPoolGetReq {
	Id int64 `json:"id"`
}

type usersPoolAddReq {
	ActivityId int64     `json:"activity_id"` // 活动id
	UserId     int64     `json:"user_id"`     // 奖品id
	Status     int64     `json:"status"`      // 状态：-1已被禁止,0未授权，1已授权
	Score      int64     `json:"score"`       // 用户在当前活动的积分
}

type usersPoolPutReq {  
	Id         int64     `json:"id"`          // 表主键
	Uuid       string    `json:"uuid"`        // 唯一识别码
	ActivityId int64     `json:"activity_id"` // 活动id
	UserId     int64     `json:"user_id"`     // 奖品id
	Status     int64     `json:"status"`      // 状态：-1已被禁止,0未授权，1已授权
	Score      int64     `json:"score"`       // 用户在当前活动的积分
}

type usersPoolDelReq {
	Id int64 `json:"id"`
}

@server(
	jwt: JwtAuth
	group: usersPool
	middleware: JwtMiddleware
    prefix: /v1/api/admin/usersPool
)
service admin-api {	
	@doc "获取用户池列表"
	@handler List
	get /list(ListReq) returns(BaseResp)

	@doc "获取用户池信息"
	@handler info 
	get /(usersPoolGetReq) returns(BaseResp)

    @doc "添加用户池"
	@handler add 
	post /(usersPoolAddReq) returns(BaseResp)

    @doc "编辑用户池"
	@handler edit 
	put /(usersPoolPutReq) returns(BaseResp)

    @doc "删除用户池"
	@handler del 
	delete /(usersPoolDelReq) returns(BaseResp)
}

