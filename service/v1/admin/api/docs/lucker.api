syntax = "v1"

type Lucker {
	Id           int64     `json:"id"`             // 表主键
	Uuid         string    `json:"uuid"`           // 唯一识别码
	UserId       int64     `json:"user_id"`        // 中奖用户id
	PrizesPoolId int64     `json:"prizes_pool_id"` // 抽中的奖品池id
	Status       int64     `json:"status"`         // 状态: -1放弃领奖，0未领奖，1已领奖
	LuckDate     int64     `json:"luck_date"`      // 抽奖时间
	Ip           string    `json:"ip"`             // ip地址
	CreateAt     int64     `json:"create_at"`      // 创建时间
	UpdateAt     int64     `json:"update_at"`      // 更新时间
	IsDeleted    int64     `json:"is_deleted"`     // 是否已被删除
	DeleteAt     int64     `json:"delete_at"`      // 删除时间
}

type LuckerGetReq {
	Id int64 `form:"id"`
}

type LuckerAddReq {
	UserId       int64     `json:"user_id"`        // 中奖用户id
	PrizesPoolId int64     `json:"prizes_pool_id"` // 抽中的奖品池id
	Status       int64     `json:"status"`         // 状态: -1放弃领奖，0未领奖，1已领奖
	LuckDate     int64     `json:"luck_date"`      // 抽奖时间
	Ip           string    `json:"ip"`             // ip地址
}

type LuckerPutReq {
	Id           int64     `json:"id"`             // 表主键
	Uuid         string    `json:"uuid"`           // 唯一识别码
	UserId       int64     `json:"user_id"`        // 中奖用户id
	PrizesPoolId int64     `json:"prizes_pool_id"` // 抽中的奖品池id
	Status       int64     `json:"status"`         // 状态: -1放弃领奖，0未领奖，1已领奖
	LuckDate     int64     `json:"luck_date"`      // 抽奖时间
	Ip           string    `json:"ip"`             // ip地址
}

type LuckerDelReq {
	Id int64 `json:"id"`
}

type LuckerDetailsReq{
	UserId      int64   `form:"user_id,optional,default=-1"`   //用户id， -1表示不用 UserId 查询
	ActivityId  int64   `form:"activity_id,optional,default=-1"`  //活动id, -1表示不用 activityId 查询
	PageSize    int64   `form:"pageSize,optional,default=20,range=[1:1000]"` //页面大小
	Page        int64   `form:"current,optional,default=1,range=[1:]"`       //当前页码
}

type LuckerDetails {
	Lucker     Lucker       `json:"lucker"`      //中奖信息
	User       User        `json:"user"`         //中奖用户信息
	PrizesPool PrizesPool  `json:"prizes_pool"`  //奖品池信息，奖品池信息
	Prize      Prize        `json:"prize"`       //奖品信息，中奖产品
	PrizeGrade PrizeGrade  `json:"prize_grade"`  //奖品级别，中奖级别
	Activity   Activity     `json:"activity"`    //活动信息，中奖活动，
	Project    Project     `json:"project"`      //项目信息，中奖项目，
}

@server(
	jwt: JwtAuth
	group: lucker
	middleware: JwtMiddleware
    prefix: /v1/api/admin/lucker
)
service admin-api {
	@doc "获取抽奖单列表"
	@handler List
	get /list(ListReq) returns(BaseResp)

	@doc "获取抽奖单详细列表"
	@handler LuckerDetails
	get /details(LuckerDetailsReq) returns(BaseResp)

	@doc "获取抽奖单信息"
	@handler info 
	get /(LuckerGetReq) returns(BaseResp)

    @doc "添加抽奖单"
	@handler add 
	post /(LuckerAddReq) returns(BaseResp)

    @doc "编辑抽奖单"
	@handler put 
	put /(LuckerPutReq) returns(BaseResp)

    @doc "删除抽奖单"
	@handler del 
	delete /(LuckerDelReq) returns(BaseResp)

    @doc "枚举列表"
	@handler enumList
	get /enumList returns([]Enum)
}
